{
  "manifest_version": 3,
  "name": "HÍBRIA",
  "description": "Análise inteligente de confiabilidade de conteúdo.",
  "version": "1.0.0",
  "action": {
    "default_title": "HÍBRIA",
    "default_popup": "index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://hibria-tcc.duckdns.org/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ]
}
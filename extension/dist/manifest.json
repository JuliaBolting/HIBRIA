{
  "manifest_version": 3,
  "name": "HÍBRIA",
  "description": "Análise inteligente de confiabilidade de conteúdo.",
  "version": "1.2.0",
  "action": {
    "default_title": "HÍBRIA",
    "default_popup": "index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://hibria-tcc.duckdns.org/*"
  ]
}
